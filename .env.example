# HASH.DEVS Environment Configuration

# Server-side Excel Storage Path (Absolute path or relative to project root)
# Default for local development: C:\hash.devs\data\inquiries.xlsx
INQUIRY_EXCEL_PATH=C:\hash.devs\data\inquiries.xlsx

# Optional: Custom API Endpoint for Frontend (defaults to /api/inquiries)
VITE_INQUIRY_API_ENDPOINT=/api/inquiries

# Server Port (if running standalone API server)
PORT=3001

